# OPTIONAL – only for developers. Copy this file to "secrets.properties" (it is ignored by Git) and enter your own keys.
# They are only used as a fallback; normal users enter their keys in the app under Settings > API keys.
#
# TMDB (posters, descriptions, cast, trailers, automatic genres): https://www.themoviedb.org/settings/api
# OMDb (IMDb and Rotten Tomatoes ratings):                       https://www.omdbapi.com/apikey.aspx
TMDB_KEY=
OMDB_KEY=
#
# Google Drive backup (optional, see docs/GOOGLE_DRIVE.md): OAuth client of type "TVs and Limited Input devices".
# Without these the Google Drive button stays hidden; the transfer over Wi-Fi always works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Trakt.tv scrobbling (optional). Create an API app at https://trakt.tv/oauth/applications
# with redirect URI "urn:ietf:wg:oauth:2.0:oob"; enter the Client ID and Client Secret here
# (or let users paste their own under Settings > API keys > Trakt).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
